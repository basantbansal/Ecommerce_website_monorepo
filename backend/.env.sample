# ==============================================================================
# 1. CORE SERVER & STARTUP CONFIGURATION (MANDATORY TO BOOT)
# ==============================================================================
# Port for the Express server to listen on (Default: 8000)
PORT=8000

# MongoDB Connection URI (MANDATORY: Server will exit with code 1 if missing or unreachable)
# Local: mongodb://localhost:27017 or Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Optional: Extra allowed CORS origins (comma-separated). Localhost:3000 & 5173 are allowed by default.
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==============================================================================
# 2. AUTHENTICATION & SECURITY (REQUIRED FOR USER LOGIN / REGISTRATION)
# ==============================================================================
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Cloudflare Turnstile Secret Key (Required for login & registration bot verification)
TURNSTILE_SECRET_KEY=

# Google OAuth Client ID (Required only if enabling "Sign in with Google")
GOOGLE_CLIENT_ID=

# ==============================================================================
# 3. OPTIONAL FEATURE INTEGRATIONS (ONLY NEEDED WHEN RESPECTIVE FEATURE IS USED)
# ==============================================================================

# Cloudinary (Required only for user avatar and product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Required only for payments & checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend Email Service (Required for email verification & password resets)
# In development, email failure is non-blocking and the verification link logs to console.
RESEND_API_KEY=
EMAIL_FROM=Amazing Store <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000

# AI Commerce Assistant (RAM Copilot)
# Connects to local OmniRoute or OpenAI-compatible server at http://localhost:20128/v1
ANTHROPIC_AUTH_TOKEN=
GOOGLE_API_KEY=
