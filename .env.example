# ==============================================================================
# Full-Stack Ecommerce Monorepo - Root Environment Template (.env.example)
# ==============================================================================
# This monorepo uses isolated environment files per workspace:
#   - Backend:  Copy backend/.env.sample to backend/.env
#   - Frontend: Copy frontend/.env.sample to frontend/.env.local
#
# Below is a quick-reference summary of the minimum required variables
# to run both services locally. No real secrets or API keys are required
# for core storefront and catalog functionality.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017

# JWT Secrets (Use any distinct random strings for local development)
ACCESS_TOKEN_SECRET=your_local_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_local_refresh_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Cloudflare Turnstile Secret Key (Login Bot Protection)
# For local testing, use Cloudflare's official dummy test secret (always passes):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Client URL (for CORS and email verification links)
FRONTEND_URL=http://localhost:3000

# Optional backend integrations (leave blank if unused during evaluation):
# GOOGLE_CLIENT_ID=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Amazing Store <onboarding@resend.dev>
# ANTHROPIC_AUTH_TOKEN=
# GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# Cloudflare Turnstile Site Key (Matches the dummy test secret above):
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional frontend integrations (leave blank if unused during evaluation):
# VITE_GOOGLE_CLIENT_ID=
# VITE_RAZORPAY_KEY_ID=
