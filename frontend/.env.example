# ==============================================================================
# Frontend Environment Configuration (.env.sample)
# Copy to .env.local for local development: cp .env.sample .env.local
# ==============================================================================

# Backend API Base URL (Defaults to http://localhost:8000 when running locally)
VITE_API_URL=http://localhost:8000

# Cloudflare Turnstile Site Key (Bot Protection)
# For local development testing, Cloudflare provides a public test sitekey that always passes:
# Test Site Key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google OAuth Client ID (Optional: required only for "Sign in with Google")
# Must match an authorized web client ID configured with origin http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Razorpay Key ID (Optional: required for checkout and payment processing)
VITE_RAZORPAY_KEY_ID=
